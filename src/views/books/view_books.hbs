<div class="container mt-4">
  <div class="row row-cols-1 row-cols-md-3 g-4">
    {{#each book}}
    <div class="col">
      <div class="card h-100 text-white bg-dark">
        <img src="{{Cover}}" class="card-img-top mx-auto mt-3" alt="Portada del libro" style="width: 150px; height: 150px; object-fit: cover;">
        <div class="card-body text-center">
          <h5 class="card-title">{{Name}}</h5>
          <p class="card-text"><strong>Autor:</strong> {{Author}}</p>
          <a href="/books/{{_id}}" class="btn btn-outline-light w-100 mb-2 btn-no-lift">
            📚 Explorar
          </a>

          {{#if ../user}}
          <div class="d-flex justify-content-between">
            <a href="/books/edit/{{_id}}" class="btn btn-sm btn-info btn-no-lift">
              <i class="fas fa-edit"></i> Editar
            </a>
            <form action="/books/delete/{{_id}}?_method=delete" method="post" class="d-inline">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="btn btn-sm btn-danger btn-no-lift">
                <i class="fa-solid fa-xmark"></i> Eliminar
              </button>
            </form>
          </div>
          {{/if}}
        </div>
      </div>
    </div>
    {{else}}
    {{#if user}}
    <div class="col-12">
      <h3 class="text-center">No se encuentran libros registrados</h3>
      <div class="d-grid gap-2 col-6 mx-auto mt-3">
        <a href="/books/add" class="btn btn-danger">Registra un nuevo libro</a>
      </div>
    </div>
    {{/if}}
    {{/each}}
  </div>
</div>

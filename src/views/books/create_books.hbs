<div class="container py-1 h-100">
  <div class="row d-flex justify-content-center align-items-center h-100 mb-4">
    <div class="col-lg-8 col-xl-6">
      <div
        class="card text-white"
        style="border-radius: 20px; background-color: #001219; color: #E0FBFC; box-shadow: 0 4px 20px rgba(0,0,0,0.3);"
      >
        <div class="card-body p-4 p-md-5">
          <h3
            class="mb-2 pb-1 pb-md-0 mb-md-5 px-md-2"
            style="color: #94D2BD;"
          >Nuevo género</h3>

          <form action="/books/genres/add" method="post" class="px-md-2">
            <div class="form-outline mb-4">
              <input
                type="text"
                class="form-control form-control-lg"
                name="NameGenre"
                id="NameGenre"
                value="{{NameGenre}}"
                style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
              />
              <label class="form-label" style="color: #94D2BD;">Nombre</label>
            </div>

            <div class="form-outline">
              <textarea
                class="form-control form-control-lg"
                name="Description"
                id="Description"
                rows="2"
                style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
              >{{Description}}</textarea>
              <label
                class="form-label"
                style="color: #94D2BD;"
              >Descripción</label>
            </div>

            <p></p>
            <button
              type="submit"
              class="btn btn-lg"
              style="background-color: #0A9396; color: #FFFFFF; border-radius: 30px; width: 100%;"
            >Registrar</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-8 col-xl-6">
      <div
        class="card text-white"
        style="border-radius: 20px; background-color: #001219; color: #E0FBFC; box-shadow: 0 4px 20px rgba(0,0,0,0.3);"
      >
        <div class="card-body p-4 p-md-5">
          <h3
            class="mb-2 pb-1 pb-md-0 mb-md-5 px-md-2"
            style="color: #94D2BD;"
          >Nueva editorial</h3>

          <form action="/books/publishers/add" method="post" class="px-md-2">
            <div class="form-outline mb-4">
              <input
                type="text"
                class="form-control form-control-lg"
                name="NamePublisher"
                id="NamePublisher"
                value="{{NamePublisher}}"
                autofocus
                style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
              />
              <label class="form-label" style="color: #94D2BD;">Nombre</label>
            </div>

            <div class="form-outline mb-4">
              <input
                type="text"
                class="form-control form-control-lg"
                name="Adress"
                id="Adress"
                value="{{Adress}}"
                autofocus
                style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
              />
              <label
                class="form-label"
                style="color: #94D2BD;"
              >Dirección</label>
            </div>

            <div class="form-outline mb-4">
              <input
                type="number"
                min="3"
                step="1"
                oninput="validity.valid||(value='');"
                name="Celphone"
                class="form-control form-control-lg"
                value="{{Celphone}}"
                style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
              />
              <label class="form-label" style="color: #94D2BD;">Número de
                contacto</label>
            </div>

            <p></p>
            <button
              type="submit"
              class="btn btn-lg"
              style="background-color: #0A9396; color: #FFFFFF; border-radius: 30px; width: 100%;"
            >Registrar</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <br />
  <div class="row d-flex justify-content-center align-items-center h-80">
    <div
      class="card text-white"
      style="border-radius: 20px; background-color: #001219; color: #E0FBFC; box-shadow: 0 4px 20px rgba(0,0,0,0.3);"
    >
    <div class="card-body p-4 p-md-5">
          <h3
            class="mb-2 pb-1 pb-md-0 mb-md-5 px-md-2"
            style="color: #94D2BD;"
          >Nuevo Autor(a)</h3>

          <form action="/authors/add" method="post" class="px-md-2">
            <div class="form-outline mb-4">
              <input
                type="text"
                class="form-control form-control-lg"
                name="NameAutor"
                id="NameAutor"
                value="{{NameAutor}}"
                style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
              />
              <label class="form-label" style="color: #94D2BD;">Nombre</label>
            </div>

            <div class="form-outline mb-4">
              <input
                type="text"
                class="form-control form-control-lg"
                name="LastNameAutor"
                id="LastNameAutor"
                value="{{LastNameAutor}}"
                style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
              />
              <label
                class="form-label"
                style="color: #94D2BD;"
              >Apellido</label>
            </div>

            <div class="form-outline mb-4">
              <input
                type="text"
                class="form-control form-control-lg"
                name="EmailAutor"
                id="EmailAutor"
                value="{{EmailAutor}}"
                style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
              />
              <label
                class="form-label"
                style="color: #94D2BD;"
              >Correo de contacto</label>
            </div>

            <p></p>
            <button
              type="submit"
              class="btn btn-lg"
              style="background-color: #0A9396; color: #FFFFFF; border-radius: 30px; width: 100%;"
            >Registrar</button>
          </form>
    </div>
  </div>
 <p></p>
  <div class="row d-flex justify-content-center align-items-center h-80">
    <div
      class="card text-white"
      style="border-radius: 20px; background-color: #001219; color: #E0FBFC; box-shadow: 0 4px 20px rgba(0,0,0,0.3);"
    >
      <div class="card-body p-4 p-md-5">
        <h3
          class="mb-4 pb-2 pb-md-0 mb-md-5 px-md-2"
          style="color: #94D2BD;"
        >Nuevo libro</h3>

        <form action="/books/add" method="post" class="px-md-2">
          <div class="row g-2">
            <div class="col-md">
              <div class="form-outline mb-4">
                <input
                  type="text"
                  class="form-control form-control-lg"
                  name="Name"
                  id="Name"
                  value="{{Name}}"
                  style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
                />
                <label class="form-label" style="color: #94D2BD;">Nombre</label>
              </div>
            </div>
            <div class="col-md">
              <div class="form-outline mb-4">
                <select
                  class="form-select"
                  name="Author"
                  id="Author"
                  style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
                >
                  {{#each Authors}}
                    <option value="{{NameAutor}}" {{#if (eq NameAutor ../Author)}}selected{{/if}}>{{NameAutor}}</option>
                  {{else}}
                    <option value="">No hay autores registrados</option>
                  {{/each}}
                </select>
                <label
                  class="form-label"
                  style="color: #94D2BD;"
                >Autor(a)</label>
              </div>
            </div>
          </div>

          <div class="row g-2">
            <div class="col-md">
              <div class="form-group mb-4">
                <select
                  class="form-select"
                  name="Genre"
                  id="Genre"
                  style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
                >
                  {{#each Genres}}
                    <option value="{{NameGenre}}" {{#if (eq NameGenre ../Genre)}}selected{{/if}}>{{NameGenre}}</option>
                  {{else}}
                    <option value="">No hay géneros literarios registrados</option>
                  {{/each}}
                </select>
                <label class="form-label" style="color: #94D2BD;">Género
                  literario</label>
              </div>
            </div>
            <div class="col-md">
              <div class="form-group mb-4">
                <select
                  class="form-select"
                  name="Publisher"
                  id="Publisher"
                  style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
                >
                  {{#each Publishers}}
                    <option value="{{NamePublisher}}" {{#if (eq NamePublisher ../Publisher)}}selected{{/if}}>{{NamePublisher}}</option>
                  {{else}}
                    <option value="">No hay editoriales registradas</option>
                  {{/each}}
                </select>
                <label
                  class="form-label"
                  style="color: #94D2BD;"
                >Editorial</label>
              </div>
            </div>
          </div>

          <div class="form-outline mb-4">
            <textarea
              class="form-control form-control-lg"
              name="Summary"
              id="Summary"
              rows="2"
              style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
            >{{Summary}}</textarea>
            <label class="form-label" style="color: #94D2BD;">Sinopsis</label>
          </div>

          <div class="form-outline mb-4">
            <input
              type="text"
              class="form-control form-control-lg"
              name="Cover"
              id="Cover"
              value="{{Cover}}"
              style="background-color: #E0FBFC; color: #001219; border-radius: 10px;"
            />
            <label class="form-label" style="color: #94D2BD;">URL de la imagen
              que actuará como portada</label>
          </div>

          <button
            type="submit"
            class="btn btn-lg"
            style="background-color: #0A9396; color: #FFFFFF; border-radius: 30px; width: 100%;"
          >Registrar</button>
        </form>
      </div>
    </div>
  </div>
</div>
<div class="container py-1 h-100">
  <div class="row d-flex justify-content-center align-items-center h-100 mb-4">
    <div class="col-lg-8 col-xl-8">
      <div class="card text-white bg-dark">
        <div class="card-body p-4 p-md-5">
          <h3 class="mb-4 pb-2 pb-md-0 mb-md-5 px-md-2">Editar préstamo</h3>

          <form
            action="/loans/edit/{{loan._id}}?_method=put"
            method="post"
            class="px-md-2"
          >
            <div class="form-outline mb-4">
              <select
                class="form-select"
                name="user"
                id="user"
              >
                <option value="{{User._id}}">{{User.Username}}</option>
                {{#each Users}}
                  <option value="{{_id}}">{{Username}}</option>
                {{/each}}
              </select>
              <label class="form-label">Usuario</label>
            </div>

            <div class="form-outline mb-4">
              <input
                type="date"
                class="form-control form-control-lg"
                name="devolution_date"
                id="devolution_date"
                value="{{loan.devolution_date}}"
              />
              <label class="form-label">Fecha de devolución</label>
            </div>

            <div class="form-outline mb-4">
              <select class="form-select" name="loan_state" id="loan_state">
                <option value="activo">Activo</option>
                <option value="finalizado">Finalizado</option>
                <option value="vencido">Vencido</option>
              </select>
              <label class="form-label">Estado del préstamo</label>
            </div>

            <div class="form-outline mb-4">
              <label class="form-label">Libros seleccionados</label>
              {{#each Books}}
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="details"
                    value='{"book":"{{_id}}","book_title":"{{Name}}"}'
                    id="book_{{_id}}"
                  />
                  <label class="form-check-label" for="book_{{_id}}">
                    {{Name}}
                  </label>
                </div>
              {{/each}}
            </div>

            <p></p>
            <button
              type="submit"
              class="btn btn-outline-light btn-floating m-1 btn-block btn-lg mx-auto"
            >
              Editar y Guardar
            </button>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>
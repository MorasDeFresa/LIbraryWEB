<div class="card text-white bg-dark">
  <section>
    <div class="container px-4 px-lg-5 my-5">
      <div class="row gx-4 gx-lg-5 align-items-center">

        <!-- Datos del préstamo -->
        <div class="col-md-6">
          <div class="small mb-1">ID: {{loan._id}}</div>
          <h1 class="display-5 fw-bolder">Préstamo</h1>

          <div class="fs-5 mb-4">
            <span><strong>Usuario:</strong> {{loan.User.Username}}</span>
          </div>

          <div class="fs-5 mb-4">
            <span><strong>Fecha de préstamo:</strong> {{loan.Loan_date_formatted}}</span>
          </div>

          <div class="fs-5 mb-4">
            <span><strong>Fecha de devolución:</strong> {{loan.Devolution_date_formatted}}</span>
          </div>

          <div class="fs-5 mb-5">
            <span><strong>Estado:</strong> {{loan.loan_state}}</span>
          </div>

          <form action="/loans">
            <button class="btn btn-outline-light btn-floating m-1 btn-block btn-lg" type="submit">
              Volver al menú principal
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</div>

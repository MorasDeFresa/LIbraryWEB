<div class="row d-flex justify-content-center align-items-center h-100 mb-4">
  {{#each loans}}
  <div class="col-lg-3 col-xl-3">
    <div class="card text-white bg-dark mb-4">
      <div class="card-body">
        <div class="text-center">
          <h5 class="card-title">Préstamo</h5>
          <p class="card-text"><strong>Usuario:</strong> {{User.Username}}</p>
          <p class="card-text"><strong>Estado:</strong> {{loan_state}}</p>
          <p class="card-text"><strong>Libros:</strong></p>
          <ul>
            {{#each details}}
            <li>{{this.book_title}}</li>
            {{else}}
            <li>No hay libros registrados</li>
            {{/each}}
          </ul>
          <a href="/loans/{{_id}}" class="btn btn-outline-light btn-floating m-1 btn-block btn-lg">
            Ver más
          </a>
        </div>
        {{#if ../user}}
          <div class="text-center mt-2">
            <a href="/loans/edit/{{_id}}" class="btn" style="--bs-btn-color: rgba(193,242,255,255);">
              <i class="fas fa-edit fa-lg"></i> Editar
            </a>
            <form action="/loans/delete/{{_id}}?_method=delete" method="post" style="display:inline-block;">
              <input type="hidden" name="_method" value="delete">
              <button class="btn" type="submit" style="--bs-btn-color: rgba(193,242,255,255);">
                <i class="fa-solid fa-xmark fa-lg"></i> Eliminar
              </button>
            </form>
          </div>
        {{else}}
        {{/if}}
      </div>
    </div>
  </div>
  {{else}}
  {{#if user}}
  <h3>
    <center>No se encuentran préstamos registrados</center>
  </h3>
  <div class="d-grid gap-2 col-6 mx-auto">
    <a href="/loans/add" class="btn btn-danger btn-block">Registrar un nuevo préstamo</a>
    <p></p>
  </div>
  {{/if}}
  {{/each}}
</div>